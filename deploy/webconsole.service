[Unit]
Description=HakuBot WebConsole
Documentation=file:__INSTALL_ROOT__/README.md
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=notify
User=webconsole
Group=webconsole
WorkingDirectory=__INSTALL_ROOT__
ExecStart=__INSTALL_ROOT__/bin/webconsole
Environment=WEBCONSOLE_CONFIG=__INSTALL_ROOT__/config.json
EnvironmentFile=-/etc/default/webconsole
Restart=always
RestartSec=3
TimeoutStopSec=15
WatchdogSec=30
NotifyAccess=main
UMask=0007

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=default
ProcSubset=all
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=__DATA_DIR__

[Install]
WantedBy=multi-user.target

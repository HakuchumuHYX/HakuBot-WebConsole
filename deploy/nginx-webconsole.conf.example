# Required additions inside the existing nginx.conf http {} block:
#
# limit_req_zone $binary_remote_addr zone=webconsole:10m rate=10r/s;
# log_format webconsole
#     '$remote_addr - $remote_user [$time_local] '
#     '"$request_method $uri $server_protocol" $status $body_bytes_sent '
#     '"$http_referer" "$http_user_agent"';
# map $http_upgrade $webconsole_connection_upgrade {
#     default upgrade;
#     ''      close;
# }

server {
    listen 54321 ssl;
    listen [::]:54321 ssl;
    server_name __PUBLIC_IP_OR_HOST__;

    ssl_certificate     __TLS_FULLCHAIN_PATH__;
    ssl_certificate_key __TLS_PRIVATE_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:WEBCONSOLE_SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    auth_basic "HakuBot WebConsole";
    auth_basic_user_file __HTPASSWD_PATH__;

    access_log __NGINX_LOG_DIR__/webconsole_access.log webconsole;
    error_log  __NGINX_LOG_DIR__/webconsole_error.log warn;

    limit_req zone=webconsole burst=20 nodelay;
    limit_req_status 429;
    limit_conn perip 10;
    client_max_body_size 16k;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cache-Control "no-store" always;

    location = /healthz { return 404; }
    location = /readyz  { return 404; }

    location = /hermes {
        return 307 /hermes/;
    }

    # Compatibility aliases for the dashboard's declared top-level pages.
    # Keep /, /api/*, and other WebConsole routes outside this allowlist.
    location ~ ^/(chat|sessions|files|analytics|models|logs|cron|skills|plugins|mcp|channels|webhooks|pairing|profiles|config|env|system|docs|login)$ {
        return 307 /hermes$request_uri;
    }

    # Hermes is a privileged local agent dashboard. It has its own password
    # gate in addition to this server's WebConsole Basic Auth.
    location = /hermes/favicon.ico {
        proxy_pass http://127.0.0.1:54322/favicon.ico;
        include __WEBCONSOLE_PROXY_INCLUDE__;
        proxy_read_timeout 60s;
        limit_req zone=webconsole burst=120 nodelay;
    }

    location = /hermes/favicon.svg {
        proxy_pass http://127.0.0.1:54322/favicon.svg;
        include __WEBCONSOLE_PROXY_INCLUDE__;
        proxy_read_timeout 60s;
        limit_req zone=webconsole burst=120 nodelay;
    }

    location ^~ /hermes/ {
        proxy_pass http://127.0.0.1:54322;
        include __WEBCONSOLE_PROXY_INCLUDE__;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $webconsole_connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        client_max_body_size 32m;
        limit_req zone=webconsole burst=120 nodelay;
    }

    # Hermes' built-in login page currently emits root-relative auth and font
    # URLs even when the dashboard is served below X-Forwarded-Prefix.
    location ^~ /auth/ {
        proxy_pass http://127.0.0.1:54322/hermes/auth/;
        include __WEBCONSOLE_PROXY_INCLUDE__;
        proxy_buffering off;
        proxy_read_timeout 60s;
        limit_req zone=webconsole burst=120 nodelay;
    }

    # Some Hermes dynamic imports are root-relative even under a prefix.
    # These aliases keep them same-origin without taking over /api/*.
    location ~ ^/(assets|ds-assets|fonts|fonts-terminal|dashboard-plugins)/(.*)$ {
        rewrite ^/(.*)$ /hermes/$1 break;
        proxy_pass http://127.0.0.1:54322;
        include __WEBCONSOLE_PROXY_INCLUDE__;
        proxy_read_timeout 60s;
        limit_req zone=webconsole burst=120 nodelay;
    }

    location = /favicon.ico {
        proxy_pass http://127.0.0.1:54322/favicon.ico;
        include __WEBCONSOLE_PROXY_INCLUDE__;
        proxy_read_timeout 60s;
        limit_req zone=webconsole burst=120 nodelay;
    }

    location = /api/storage/cleanup/preview {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:54322;
        include __WEBCONSOLE_PROXY_INCLUDE__;
        proxy_read_timeout 60s;
    }

    location = /api/storage/cleanup {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:54322;
        include __WEBCONSOLE_PROXY_INCLUDE__;
        proxy_read_timeout 60s;
    }

    location = /api/storage/reclaim {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:54322;
        include __WEBCONSOLE_PROXY_INCLUDE__;
        proxy_read_timeout 60s;
    }

    location = /api/stream {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:54322;
        include __WEBCONSOLE_PROXY_INCLUDE__;
        proxy_buffering off;
        proxy_read_timeout 1h;
        gzip off;
    }

    location ~ ^/api/events/[0-9]+/raw/(input|output|logs)$ {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:54322;
        include __WEBCONSOLE_PROXY_INCLUDE__;
        proxy_buffering off;
        proxy_read_timeout 10m;
    }

    location ~ ^/api/diagnostics/[0-9]+$ {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:54322;
        include __WEBCONSOLE_PROXY_INCLUDE__;
        proxy_buffering off;
        proxy_read_timeout 10m;
    }

    location / {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:54322;
        include __WEBCONSOLE_PROXY_INCLUDE__;
        proxy_read_timeout 60s;
    }
}

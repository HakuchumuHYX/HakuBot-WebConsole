# Optional environment override. The JSON file is the primary configuration.
WEBCONSOLE_CONFIG=__INSTALL_ROOT__/config.json

# Every config.json field can be overridden when needed:
# WEBCONSOLE_LISTEN=127.0.0.1:54322
# WEBCONSOLE_DB_PATH=/var/lib/hakubot-webconsole/webconsole.db
# WEBCONSOLE_SPOOL_PATH=/var/lib/hakubot-webconsole/spool
# WEBCONSOLE_PUBLIC_ORIGIN=https://203.0.113.10:54321
# WEBCONSOLE_RETENTION_DAYS=90
# WEBCONSOLE_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_SECRET
